# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored so nothing here ever gets committed to GitHub.

# Used by Flask to sign login session cookies. Set this to any long random string -
# for example, run this in a terminal to generate one: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-string

# Required for Sprint 3's AI features: paper summaries (services/openai_service.py's
# summarize_paper()) and relevance analysis (analyze_relevance()). Without a key, those
# buttons show an "Add an OpenAI key" message instead of failing silently. Get a key
# (a card on file is required, but usage on the cheap model these features use is a
# fraction of a cent per paper) at https://platform.openai.com/api-keys - create one,
# copy it (it's only ever shown once), and paste it here.
OPENAI_API_KEY=

# Optional, but recommended once you're doing real searches - without this, Semantic
# Scholar requests share ONE rate-limit pool with every other unauthenticated user on
# the internet, so they fail (429) far more often than OpenAlex's requests do - this is
# why search results can skew heavily toward OpenAlex. A free personal key instead
# guarantees this app its own 1 request/second, independent of everyone else's traffic.
# Request one (free, via email) at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
